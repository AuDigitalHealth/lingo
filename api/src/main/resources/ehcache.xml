<config xmlns:jsr107="http://www.ehcache.org/v3/jsr107"
  xmlns="http://www.ehcache.org/v3">
  <service>
    <jsr107:defaults enable-management="true" enable-statistics="true"/>
  </service>

  <!-- This file configures Hibernate's second-level cache ONLY (bootstrapped by Hibernate via
       spring.jpa.properties.javax.cache.uri / Ehcache classpath auto-discovery). All Spring
       @Cacheable/@CacheEvict caches live on the Caffeine CacheManager defined in
       CacheManagerConfig - JCache's Cache implementation cannot back Spring's reactive @Cacheable
       adaptation (Cache.retrieve(key) throws UnsupportedOperationException), so Spring-abstraction
       caching was consolidated on Caffeine, which supports both synchronous and reactive use. -->

  <!-- Hibernate second-level caches -->
  <cache alias="org.hibernate.cache.spi.UpdateTimestampsCache">
    <expiry>
      <ttl unit="seconds">120</ttl>
    </expiry>
    <heap unit="entries">10000</heap>
  </cache>

  <cache alias="org.hibernate.cache.internal.StandardQueryCache">
    <expiry>
      <ttl unit="seconds">120</ttl>
    </expiry>
    <heap unit="entries">10000</heap>
  </cache>

</config>
