<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://maven.apache.org/POM/4.0.0"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <artifactId>lingo</artifactId>

  <build>
    <plugins>
      <plugin>
        <artifactId>license-maven-plugin</artifactId>
        <configuration>
          <failOnBlacklist>true</failOnBlacklist>
          <failOnMissing>true</failOnMissing>
          <!-- Always regenerate from scratch. Without this the plugin skips
               rewriting an up-to-date file, which would let the npm listing that
               maven-antrun appends afterwards accumulate (double-append) across
               builds. Forcing regeneration keeps LICENSE/NOTICE/THIRD_PARTY_NOTICES.md
               idempotent and deterministic. -->
          <force>true</force>
          <includeTransitiveDependencies>true</includeTransitiveDependencies>
          <!-- Only report on what is actually distributed. Test/provided/system
               scoped dependencies (JUnit, JaCoCo, WireMock, Testcontainers,
               annotation processors, etc.) are not shipped in the Jib image and
               therefore carry no distribution obligation. -->
          <excludedScopes>test,provided,system</excludedScopes>
          <!-- Snomio's own reactor modules (au.gov.digitalhealth:*) are not
               third-party and must not appear in the third-party notices. They
               also resolve to a SNAPSHOT whose timestamp changes every build
               (e.g. lingo-auth from the remote snapshot repo), which would make
               the generated notices non-deterministic and break the CI drift
               check. Exclude the whole group. -->
          <excludedGroups>au\.gov\.digitalhealth</excludedGroups>
          <!-- Allowlist of licences permitted in the *distributed* closure. Every
               entry below is either permissive or file/library-level (weak) copyleft
               and is therefore compatible with re-distributing an Apache-2.0 work.
               No strong copyleft (GPL/AGPL), CDDL or commercial licence is permitted:
               such a dependency causes the build to fail via failOnBlacklist. -->
          <includedLicenses>
            <includedLicense>Apache License, Version 2.0</includedLicense>
            <includedLicense>Apache License Version 2.0, January 2004</includedLicense>
            <includedLicense>BSD License</includedLicense>
            <includedLicense>BSD-2-Clause</includedLicense>
            <includedLicense>Eclipse Distribution License v. 1.0</includedLicense>
            <includedLicense>GNU LGPL Version 3.0</includedLicense>
            <includedLicense>GNU Library General Public License v2.1 or later</includedLicense>
            <includedLicense>Eclipse Public License 1.0</includedLicense>
            <includedLicense>Eclipse Public License 2.0</includedLicense>
            <includedLicense>MIT License</includedLicense>
            <includedLicense>MIT-0</includedLicense>
            <includedLicense>Public Domain</includedLicense>
            <includedLicense>CDDL 1.1</includedLicense>
            <includedLicense>Eclipse Distribution License - v 1.0</includedLicense>
          </includedLicenses>
          <!-- Normalise the many upstream spellings of each licence onto one
               canonical name (the left-hand token), which must appear in the
               allowlist above. These are synonym mappings only; no mapping changes
               a dependency's actual licence family. -->
          <licenseMerges>
            <licenseMerge>Apache License, Version 2.0|Apache License Version 2.0|Apache Software License 2.0|The Apache License, Version 2.0|The Apache Software License, Version 2.0|Apache 2.0 License|Apache License 2.0|Apache-2.0|Apache 2.0|Apache Software Licenses|Apache 2|ASF 2.0|Apache Public License 2.0</licenseMerge>
            <licenseMerge>BSD License|BSD New|The BSD License|New BSD License|BSD-3-Clause|The New BSD License|The BSD 3-Clause License|The BSD 3-Clause License (BSD3)|BSD License 3|BSD 3-Clause|Revised BSD License</licenseMerge>
            <licenseMerge>Eclipse Distribution License v. 1.0|EDL 1.0|Eclipse Distribution License v1.0|Eclipse Distribution License - v 1.0|Eclipse Distribution License (New BSD License)</licenseMerge>
            <licenseMerge>Eclipse Public License 1.0|Eclipse Public License - v 1.0|EPL 1.0</licenseMerge>
            <licenseMerge>Eclipse Public License 2.0|Eclipse Public License - v 2.0|EPL 2.0|EPL-2.0|Eclipse Public License (EPL) 2.0|Eclipse Public License v2.0|Eclipse Public License v. 2.0</licenseMerge>
            <licenseMerge>MIT License|The MIT License (MIT)|The MIT License|MIT|The JSON License</licenseMerge>
            <licenseMerge>Public Domain|Public Domain, per Creative Commons CC0|CC0|CC0 1.0 Universal|Creative Commons Zero</licenseMerge>
          </licenseMerges>
          <sortArtifactByName>true</sortArtifactByName>
        </configuration>
        <executions>
          <!-- The three executions below regenerate LICENSE, NOTICE and
               THIRD_PARTY_NOTICES.md in the repository root on every build, so
               they can never drift from the actual distributed dependency tree.
               A CI check (see azure-pipelines.yml) fails the build if a commit
               leaves them stale. -->
          <!-- Generates the third-party licence listing embedded in LICENSE. -->
          <execution>
            <id>generate-license</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>aggregate-add-third-party</goal>
            </goals>
            <configuration>
              <thirdPartyFilename>LICENSE</thirdPartyFilename>
              <outputDirectory>${project.basedir}</outputDirectory>
              <fileTemplate>${project.basedir}/src/license/license-file.ftl</fileTemplate>
            </configuration>
          </execution>
          <!-- Generates the human-readable THIRD_PARTY_NOTICES.md. -->
          <execution>
            <id>generate-third-party-notices</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>aggregate-add-third-party</goal>
            </goals>
            <configuration>
              <thirdPartyFilename>THIRD_PARTY_NOTICES.md</thirdPartyFilename>
              <outputDirectory>${project.basedir}</outputDirectory>
              <fileTemplate>${project.basedir}/src/license/third-party-notices.ftl</fileTemplate>
            </configuration>
          </execution>
          <!-- Generates the NOTICE file (Apache-2.0 section 4(d)). -->
          <execution>
            <id>generate-notice</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>aggregate-add-third-party</goal>
            </goals>
            <configuration>
              <thirdPartyFilename>NOTICE</thirdPartyFilename>
              <outputDirectory>${project.basedir}</outputDirectory>
              <fileTemplate>${project.basedir}/src/license/notice.ftl</fileTemplate>
            </configuration>
          </execution>
        </executions>
        <groupId>org.codehaus.mojo</groupId>
        <version>2.4.0</version>
      </plugin>
      <!-- Generates a CycloneDX Software Bill of Materials (SBOM) for the whole
           reactor at target/sbom.json and target/sbom.xml. Test-scope artefacts
           are excluded so the SBOM matches what is actually distributed. -->
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <version>2.9.1</version>
        <!-- makeAggregateBom builds a single SBOM for the whole reactor, so it
             must run only on the root project, not once per inherited module. -->
        <inherited>false</inherited>
        <configuration>
          <projectType>application</projectType>
          <outputFormat>all</outputFormat>
          <outputName>sbom</outputName>
          <includeTestScope>false</includeTestScope>
          <includeProvidedScope>false</includeProvidedScope>
        </configuration>
        <executions>
          <execution>
            <id>generate-sbom</id>
            <phase>package</phase>
            <goals>
              <goal>makeAggregateBom</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- license-maven-plugin only sees the Maven (Java) dependency tree. The
           frontend (npm) components are listed in ui/dependency-licenses, produced
           by ui/record-npm-dependency-licenses.cjs. This step appends that npm
           listing onto the freshly generated LICENSE and THIRD_PARTY_NOTICES.md so
           both cover the whole distributed product. It runs at process-resources,
           i.e. after the generate-resources license executions overwrite those two
           files, so re-runs never double-append. -->
      <plugin>
        <artifactId>maven-antrun-plugin</artifactId>
        <groupId>org.apache.maven.plugins</groupId>
        <version>3.1.0</version>
        <inherited>false</inherited>
        <executions>
          <execution>
            <id>append-npm-third-party</id>
            <phase>process-resources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <!-- LICENSE keeps the flat npm listing (matches its backend
                     listing format). -->
                <concat append="true" destfile="${project.basedir}/LICENSE">
                  <fileset file="${project.basedir}/ui/dependency-licenses"/>
                </concat>
                <!-- THIRD_PARTY_NOTICES.md gets the structured Markdown npm
                     section (summary table + component list) produced by
                     ui/format-third-party-notices-npm.cjs. -->
                <concat append="true" destfile="${project.basedir}/THIRD_PARTY_NOTICES.md">
                  <string>${line.separator}</string>
                  <fileset file="${project.basedir}/ui/third-party-notices-npm.md"/>
                </concat>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>license-maven-plugin</artifactId>
        <configuration>
          <header>src/license/HEADER.txt</header>
          <includes>
            <include>**/pom.xml</include>
          </includes>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>format</goal>
            </goals>
            <phase>validate</phase>
          </execution>
        </executions>
        <groupId>com.mycila</groupId>
        <version>5.0.0</version>
      </plugin>
      <plugin>
        <artifactId>gitflow-maven-plugin</artifactId>
        <configuration>
          <gitFlowConfig>
            <developmentBranch>main</developmentBranch>
            <productionBranch>main</productionBranch>
          </gitFlowConfig>
        </configuration>
        <groupId>com.amashchenko.maven.plugin</groupId>
        <version>1.21.0</version>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <groupId>org.apache.maven.plugins</groupId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <artifactId>lombok</artifactId>
              <groupId>org.projectlombok</groupId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <artifactId>sergio-extension</artifactId>
        <groupId>au.gov.digitalhealth</groupId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <artifactId>lingo-common</artifactId>
        <groupId>au.gov.digitalhealth</groupId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <artifactId>lingo-auth</artifactId>
        <groupId>au.gov.digitalhealth</groupId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <artifactId>snakeyaml</artifactId>
        <groupId>org.yaml</groupId>
        <version>2.6</version>
      </dependency>
      <dependency>
        <artifactId>lombok</artifactId>
        <groupId>org.projectlombok</groupId>
        <version>${lombok.version}</version>
      </dependency>
      <!-- jackson-datatype-jsr310 managed by Spring Boot 4 BOM — no explicit version needed -->
      <!-- commons-io is NOT managed by the Spring Boot 4 BOM: it arrives transitively (e.g. via the
           maven-resources-plugin that lingo-common pulls onto the compile classpath) at 2.11.0,
           which carries CVE-2024-47554 (fixed in 2.14.0). Force every transitive to a safe version. -->
      <dependency>
        <artifactId>commons-io</artifactId>
        <groupId>commons-io</groupId>
        <version>2.17.0</version>
      </dependency>
      <!-- plexus-utils arrives transitively via build plugins on the compile classpath
           (maven-resources-plugin -> 3.5.1, jacoco-maven-plugin -> 3.0.24), both carrying
           CVE-2025-67030 (fixed in 3.6.1). Force every transitive to the fixed version. -->
      <dependency>
        <artifactId>plexus-utils</artifactId>
        <groupId>org.codehaus.plexus</groupId>
        <version>3.6.1</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <description>An integration with Snomed International's Authoring Platform that extends
    functionality to improve authoring of medicinal terminology.
  </description>
  <distributionManagement>
    <repository>
      <id>${deployment.repo.id}</id>
      <layout>default</layout>
      <name>Maven Release Feed</name>
      <uniqueVersion>true</uniqueVersion>
      <url>${deployment.repo.url}</url>
    </repository>
    <snapshotRepository>
      <id>${deployment.repo.id}</id>
      <layout>default</layout>
      <name>Maven Snapshot Release Feed</name>
      <uniqueVersion>true</uniqueVersion>
      <url>${deployment.repo.url}</url>
    </snapshotRepository>
  </distributionManagement>
  <groupId>au.gov.digitalhealth</groupId>
  <modelVersion>4.0.0</modelVersion>

  <modules>
    <module>ui</module>
    <module>auth</module>
    <module>common</module>
    <module>api</module>
    <module>eclrefset</module>
  </modules>
  <name>lingo</name>

  <packaging>pom</packaging>


  <parent>
    <artifactId>spring-boot-starter-parent</artifactId>
    <groupId>org.springframework.boot</groupId>
    <relativePath/>
    <version>4.1.0</version>
  </parent>

  <pluginRepositories>
    <pluginRepository>
      <id>${deployment.repo.id}</id>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
      <url>${deployment.repo.url}</url>
    </pluginRepository>
  </pluginRepositories>

  <profiles>
    <profile>
      <activation>
        <property>
          <name>env.CI</name>
          <value>true</value>
        </property>
      </activation>
      <id>dev</id>
      <modules>
        <module>auth</module>
        <module>common</module>
        <module>api</module>
      </modules>
    </profile>
  </profiles>

  <properties>
    <deployment.repo.id>snomio</deployment.repo.id>
    <deployment.repo.url>
      https://pkgs.dev.azure.com/OD225632-NCTS-ContentAndTooling/Snomio/_packaging/snomio/maven/v1
    </deployment.repo.url>
    <gson.version>2.11.0</gson.version>
    <jgrapht-core.version>1.5.2</jgrapht-core.version>
    <netty.version>4.2.16.Final</netty.version>
    <!-- Override Spring Boot 4.1.0's managed Jackson versions with their patch fixes for
         CVE-2026-59889 / CVE-2026-54515 (and GHSA-mhm7-754m-9p8w). jackson-2-bom is the 2.x compat
         line, jackson-bom is Jackson 3.x (Spring Boot 4's primary). Both are patch bumps within the
         same minor. -->
    <jackson-2-bom.version>2.21.5</jackson-2-bom.version>
    <jackson-bom.version>3.1.5</jackson-bom.version>
    <json-schema.version>4.36.0</json-schema.version>
    <lombok.version>1.18.46</lombok.version>
    <rest-assured.version>6.0.0</rest-assured.version>
    <snowstorm-java-client.version>8.1.3-SNAPSHOT</snowstorm-java-client.version>
  </properties>

  <repositories>
    <repository>
      <id>${deployment.repo.id}</id>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
      <url>
        ${deployment.repo.url}
      </url>
    </repository>
    <repository>
      <id>ihtsdo-releases</id>
      <name>ihtsdo-releases</name>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <url>https://nexus3.ihtsdotools.org/repository/maven-releases/</url>
    </repository>
    <repository>
      <id>ihtsdo-snapshots</id>
      <name>ihtsdo-snapshots</name>
      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
      <url>https://nexus3.ihtsdotools.org/repository/maven-snapshots/</url>
    </repository>
  </repositories>


  <version>1.4.0</version>

</project>